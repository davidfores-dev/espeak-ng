<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Matxa TTS (valencia)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/matxa_text_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:gravity="top"
        android:hint="Escriu aci el que vullgues dir..."
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/matxa_speaker_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/matxa_speaker_lluc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lluc"
            android:checked="true" />

        <RadioButton
            android:id="@+id/matxa_speaker_gina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gina"
            android:layout_marginStart="24dp" />
    </RadioGroup>

    <Button
        android:id="@+id/matxa_play_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reproduir"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/matxa_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/matxa_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="" />

</LinearLayout>

